#!/bin/zsh
# ─────────────────────────────────────────────────────────────────────────────
# 맥 — 이 파일을 **두 번 누르십시오.** 터미널이 열리고 점검이 돕니다.
#
# ⭐ 왜 이 파일이 따로 있나 — `.sh` 파일은 두 번 눌러도 돌지 않는다(글자 편집기가 열린다).
#    `.command` 확장자만 맥 파인더에서 **두 번 눌러 실행**된다.
#    🚫 사람에게 경로를 타이핑하게 만들지 않는다 — 그것이 첫 관문이 되어 버린다.
#
# ⚠️ 「확인되지 않은 개발자」라며 안 열리면:
#    이 파일을 **오른쪽 클릭 → 열기**를 고르고, 다시 한 번 **열기**를 누르십시오.
#    인터넷에서 받은 파일은 맥이 한 번 막습니다. 한 번만 그렇게 해 주면 그다음부터는 그냥 열립니다.
# ─────────────────────────────────────────────────────────────────────────────
HERE="${0:A:h}"          # 이 파일이 있는 폴더 — 어디에 두어도 스스로 찾는다
cd "$HERE" || exit 1
print -r -- ""
print -r -- "  환경 점검을 시작합니다."
print -r -- "  폴더: $HERE"
print -r -- ""
zsh "$HERE/환경점검.sh"
print -r -- ""
print -r -- "  ── 끝났습니다. 이 창은 닫아도 됩니다. ──"
print -r -- ""
